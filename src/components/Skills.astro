---
import { skills } from '../data/data.ts';

const stats = [
  { label: 'Years Experience', value: '3.5+' },
  { label: 'Projects Delivered', value: '50+' },
  { label: 'Technologies', value: '30+' },
  { label: 'Code Quality', value: '95%' },
];
---

<section id="skills" class="py-20 px-6 bg-gray-50 dark:bg-gray-900">
  <div class="max-w-7xl mx-auto">
    {/* Section Header */}
    <div class="text-center mb-12">
      <h2 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-4">
        Technical Skills
      </h2>
      <p class="text-lg text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
        A comprehensive toolkit spanning backend development, AI/ML, healthcare tech, and cloud infrastructure
      </p>
    </div>

    {/* Compact Skills List */}
    <div class="bg-white dark:bg-gray-800 rounded-2xl p-8 border border-gray-200 dark:border-gray-700 shadow-lg">
      <div class="space-y-6">
        {skills.map((group, categoryIndex) => (
          <div class="opacity-0" data-skill-item style={`animation-delay: ${categoryIndex * 100}ms`}>
            {/* Category Title */}
            <div class="flex items-start gap-4">
              <h3 class="text-base font-bold text-gray-900 dark:text-white min-w-[200px] pt-1">
                {group.title}:
              </h3>

              {/* Skills in one line */}
              <div class="flex-1">
                <p class="text-base text-gray-700 dark:text-gray-300 leading-relaxed">
                  {group.items.map((item, index) => (
                    <span>
                      {item.name}
                      {index < group.items.length - 1 && ', '}
                    </span>
                  ))}
                </p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    {/* Stats */}
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mt-12">
      {stats.map((stat, index) => (
        <div
          class="text-center p-6 rounded-xl bg-white dark:bg-gray-800 border-2 border-primary/30 dark:border-primary/30 hover:border-primary dark:hover:border-primary transition-all duration-300 opacity-0"
          data-stat-item
          style={`animation-delay: ${600 + index * 100}ms`}
        >
          <div class="text-3xl md:text-4xl font-bold text-primary mb-2">
            {stat.value}
          </div>
          <div class="text-sm text-gray-600 dark:text-gray-400 font-medium">
            {stat.label}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const section = document.getElementById('skills');
  if (section) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          section.querySelectorAll<HTMLElement>('[data-skill-item]').forEach((el) => {
            el.classList.remove('opacity-0');
            el.classList.add('animate-fade-in');
          });
          section.querySelectorAll<HTMLElement>('[data-stat-item]').forEach((el) => {
            el.classList.remove('opacity-0');
            el.classList.add('animate-slide-up');
          });
          observer.unobserve(section);
        }
      },
      { threshold: 0.1 }
    );
    observer.observe(section);
  }
</script>
