---
import { bio } from '../data/data.ts';
import Icon from './Icon.astro';
---

<section
  id="home"
  class="min-h-screen flex items-center justify-center px-6 pt-20 bg-white dark:bg-gray-900"
>
  <div class="max-w-5xl mx-auto text-center">
    {/* Greeting */}
    <div class="inline-block px-4 py-2 rounded-full bg-primary/10 text-primary text-sm font-semibold mb-8 animate-fade-in">
      👋 Hi there! I'm
    </div>

    {/* Name */}
    <h1 class="text-5xl md:text-7xl font-bold text-gray-900 dark:text-white mb-6 animate-slide-up">
      {bio.name}
    </h1>

    {/* Typing Animation */}
    <div class="text-2xl md:text-4xl font-semibold mb-8 h-20 text-primary">
      <span id="hero-typewriter"></span><span class="hero-caret">|</span>
    </div>

    {/* Description */}
    <p class="text-lg md:text-xl text-gray-600 dark:text-gray-400 max-w-3xl mx-auto mb-8 leading-relaxed animate-fade-in">
      {bio.tagline}
    </p>

    {/* Location */}
    <div class="flex items-center justify-center gap-2 text-gray-600 dark:text-gray-400 mb-8">
      <Icon name="map-pin" class="w-5 h-5 text-primary" />
      <span>{bio.location}</span>
    </div>

    {/* Social Links */}
    <div class="flex justify-center gap-4 mb-8 flex-wrap">
      <a
        href={bio.social.github}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2 px-6 py-3 rounded-lg bg-white dark:bg-gray-800 border-2 border-gray-300 dark:border-gray-700 text-gray-700 dark:text-gray-300 hover:border-primary dark:hover:border-primary hover:text-primary dark:hover:text-primary transition-all font-medium"
        aria-label="GitHub"
      >
        <Icon name="github" class="w-5 h-5" />
        <span>GitHub</span>
      </a>
      <a
        href={bio.social.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2 px-6 py-3 rounded-lg bg-white dark:bg-gray-800 border-2 border-gray-300 dark:border-gray-700 text-gray-700 dark:text-gray-300 hover:border-primary dark:hover:border-primary hover:text-primary dark:hover:text-primary transition-all font-medium"
        aria-label="LinkedIn"
      >
        <Icon name="linkedin" class="w-5 h-5" />
        <span>LinkedIn</span>
      </a>
      <a
        href={`https://mail.google.com/mail/?view=cm&fs=1&to=${encodeURIComponent(bio.email)}`}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2 px-6 py-3 rounded-lg bg-white dark:bg-gray-800 border-2 border-gray-300 dark:border-gray-700 text-gray-700 dark:text-gray-300 hover:border-primary dark:hover:border-primary hover:text-primary dark:hover:text-primary transition-all font-medium"
        aria-label="Email"
      >
        <Icon name="mail" class="w-5 h-5" />
        <span>Email</span>
      </a>
    </div>

    {/* CTA Button */}
    <div class="flex justify-center gap-4">
      <a
        href={bio.resumeLink}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-8 py-4 bg-primary hover:bg-primary-dark text-white rounded-lg font-semibold transition-all hover:scale-105 shadow-lg"
      >
        <Icon name="download" class="w-5 h-5" />
        Download Resume
      </a>
      <a
        href="#contact"
        class="inline-flex items-center gap-2 px-8 py-4 bg-white dark:bg-gray-800 border-2 border-primary text-primary rounded-lg font-semibold transition-all hover:scale-105 hover:bg-primary hover:text-white"
      >
        Let's Talk
      </a>
    </div>
  </div>
</section>

<style>
  .hero-caret {
    animation: hero-blink 1s step-end infinite;
  }
  @keyframes hero-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }
</style>

<script define:vars={{ roles: bio.roles }}>
  const el = document.getElementById('hero-typewriter');
  if (el && Array.isArray(roles) && roles.length > 0) {
    const typeSpeed = 50;
    const deleteSpeed = 30;
    const pauseAfterType = 2000;
    const pauseAfterDelete = 400;
    let roleIndex = 0;
    let charIndex = 0;
    let deleting = false;

    function tick() {
      const current = roles[roleIndex];
      if (!deleting) {
        charIndex++;
        el.textContent = current.slice(0, charIndex);
        if (charIndex === current.length) {
          deleting = true;
          setTimeout(tick, pauseAfterType);
          return;
        }
        setTimeout(tick, typeSpeed);
      } else {
        charIndex--;
        el.textContent = current.slice(0, charIndex);
        if (charIndex === 0) {
          deleting = false;
          roleIndex = (roleIndex + 1) % roles.length;
          setTimeout(tick, pauseAfterDelete);
          return;
        }
        setTimeout(tick, deleteSpeed);
      }
    }

    tick();
  }
</script>
