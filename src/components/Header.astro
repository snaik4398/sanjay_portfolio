---
/*
 * Sticky header: wordmark, section nav, theme toggle, and a mobile menu.
 *
 * The mobile menu is a <details>/<summary> disclosure rather than a JS-toggled panel, so it
 * works without JavaScript and needs no aria-expanded kept in sync by hand. The small script
 * only closes it after a jump and on Escape.
 */
import {NAV_LINKS, SITE} from '../data/portfolio';
import ThemeToggle from './ThemeToggle.astro';
---

<header
  class="sticky top-0 z-50 border-b border-border bg-bg/85 backdrop-blur-md no-print"
>
  <div class="mx-auto flex h-16 max-w-6xl items-center gap-4 gutter">
    <a
      href="/"
      class="shrink-0 font-mono text-sm font-semibold tracking-tight text-fg transition-colors duration-150 hover:text-accent"
      translate="no">{SITE.title}</a
    >

    <nav aria-label="Sections" class="ml-auto hidden md:block">
      <ul class="flex items-center gap-1">
        {
          NAV_LINKS.map((link) => (
            <li>
              <a
                href={link.href}
                class="rounded-[var(--radius-sm)] px-3 py-2 text-sm text-fg-muted transition-colors duration-150 hover:bg-surface-2 hover:text-fg"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-2 md:ml-0">
      <ThemeToggle />
      <details class="relative md:hidden" id="mobile-nav">
        <summary
          class="inline-flex size-9 cursor-pointer list-none items-center justify-center rounded-[var(--radius-sm)] border border-border bg-surface text-fg-muted transition-[color,background-color,border-color] duration-150 hover:border-border-strong hover:text-fg"
          aria-label="Open section menu"
          style="touch-action: manipulation;"
        >
          <svg
            class="size-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
        </summary>
        <nav
          aria-label="Sections"
          class="absolute right-0 top-11 w-48 rounded-[var(--radius)] border border-border bg-surface p-1.5 shadow-[var(--card-shadow)]"
        >
          <ul>
            {
              NAV_LINKS.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="block rounded-[var(--radius-sm)] px-3 py-2 text-sm text-fg-muted transition-colors duration-150 hover:bg-surface-2 hover:text-fg"
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  // Close the mobile menu after a jump, and on Escape.
  const details = document.getElementById('mobile-nav') as HTMLDetailsElement | null;
  if (details) {
    details.querySelectorAll('a').forEach((anchor) =>
      anchor.addEventListener('click', () => {
        details.open = false;
      }),
    );
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && details.open) {
        details.open = false;
        details.querySelector('summary')?.focus();
      }
    });
  }
</script>
