---
import { education } from '../data/constants.js';
---

<section id="education" class="py-20">
  <div class="mx-auto max-w-4xl px-6">
    <h2 class="text-center text-4xl font-bold">Education</h2>
    <p class="mx-auto mt-3 max-w-2xl text-center text-muted">
      My education has been a journey of learning and growth. Here are the details.
    </p>

    <ol class="relative mt-12 border-l border-brand/40 pl-6 sm:pl-8">
      {education.map((edu) => (
        <li class="relative mb-8">
          <span class="absolute -left-[31px] top-3 h-3.5 w-3.5 rounded-full border-2 border-brand bg-surface sm:-left-[39px]"></span>
          <div class="rounded-xl border border-brand/40 bg-card p-5 shadow-[0_4px_24px_rgba(133,76,230,0.12)] transition-transform hover:-translate-y-1">
            <div class="flex gap-4">
              <img src={edu.img} alt={edu.school} loading="lazy" class="h-12 w-12 flex-shrink-0 rounded-lg bg-white/90 object-contain p-1" />
              <div>
                <h3 class="font-semibold text-ink">{edu.school}</h3>
                <p class="text-sm text-muted">{edu.degree}</p>
                <p class="text-xs text-muted/80">{edu.date}</p>
              </div>
            </div>
            <p class="mt-3 text-sm font-medium text-ink/80"><span class="text-brand">Grade:</span> {edu.grade}</p>
            <p class="mt-2 text-sm leading-relaxed text-ink/70">{edu.desc}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
