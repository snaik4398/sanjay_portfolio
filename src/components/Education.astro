---
import { education, certifications } from '../data/data.ts';
import Icon from './Icon.astro';
---

<section id="education" class="py-20 px-6 bg-white dark:bg-gray-900">
  <div class="max-w-7xl mx-auto">
    {/* Section Header */}
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-4">
        Education & Certifications
      </h2>
      <p class="text-lg text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
        Academic foundation and professional certifications in computer science and emerging technologies
      </p>
    </div>

    {/* Education */}
    <div class="mb-16">
      <div class="flex items-center gap-3 mb-8">
        <Icon name="graduation-cap" class="w-8 h-8 text-primary" />
        <h3 class="text-3xl font-bold text-gray-900 dark:text-white">Education</h3>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {education.map((edu) => (
          <div
            class="bg-gray-50 dark:bg-gray-800 rounded-2xl p-6 border border-gray-200 dark:border-gray-700 hover:border-primary/50 dark:hover:border-primary/50 hover:shadow-xl transition-all duration-300"
          >
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 w-12 h-12 relative">
                <img
                  src={edu.logo}
                  alt={`${edu.school} logo`}
                  width="48"
                  height="48"
                  class="rounded-lg object-contain"
                  style="width: auto; height: auto; max-width: 48px; max-height: 48px;"
                />
              </div>
              <div class="flex-1">
                <h4 class="text-xl font-bold text-gray-900 dark:text-white mb-2">
                  {edu.degree}
                </h4>
                <p class="text-gray-700 dark:text-gray-300 font-medium mb-2">
                  {edu.school}
                </p>
                <div class="flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400 mb-2">
                  <Icon name="calendar" class="w-4 h-4 text-primary" />
                  <span>{edu.period}</span>
                </div>
                <div class="flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400">
                  <Icon name="map-pin" class="w-4 h-4 text-primary" />
                  <span>{edu.location}</span>
                </div>
                <p class="text-sm font-semibold text-primary mt-3">
                  {edu.grade}
                </p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    {/* Certifications */}
    <div>
      <div class="flex items-center gap-3 mb-8">
        <Icon name="award" class="w-8 h-8 text-primary" />
        <h3 class="text-3xl font-bold text-gray-900 dark:text-white">Certifications</h3>
      </div>
      <div class="space-y-6">
        {certifications.map((cert) => (
          <div
            class="bg-gray-50 dark:bg-gray-800 rounded-2xl p-6 border border-gray-200 dark:border-gray-700 hover:border-primary/50 dark:hover:border-primary/50 hover:shadow-xl transition-all duration-300"
          >
            <div class="flex items-start justify-between gap-4">
              <div class="flex-1">
                <h4 class="text-xl font-bold text-gray-900 dark:text-white mb-2">
                  {cert.title}
                </h4>
                <p class="text-gray-700 dark:text-gray-300 font-medium mb-3">
                  {cert.issuer}
                </p>
                <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed">
                  {cert.description}
                </p>
              </div>
              {cert.link && (
                <a
                  href={cert.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex-shrink-0 inline-flex items-center gap-2 px-4 py-2 bg-primary hover:bg-primary-dark text-white rounded-lg transition-colors font-medium text-sm"
                >
                  View Certificate
                  <Icon name="external-link" class="w-4 h-4" />
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
