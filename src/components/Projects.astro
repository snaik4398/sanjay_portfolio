---
import { projects } from '../data/constants.js';
import { Bio } from '../data/constants.js';
---

<section id="projects" class="py-20">
  <div class="mx-auto max-w-6xl px-6">
    <h2 class="text-center text-4xl font-bold">Projects</h2>
    <p class="mx-auto mt-3 max-w-2xl text-center text-muted">
      A selection of things I have built. More on the way.
    </p>

    {projects.length === 0 ? (
      <div class="mx-auto mt-12 max-w-xl rounded-2xl border border-brand/40 bg-card p-10 text-center shadow-[0_4px_24px_rgba(133,76,230,0.12)]">
        <p class="text-lg text-ink/85">Featured projects are being polished and added soon.</p>
        <p class="mt-2 text-sm text-muted">In the meantime, explore my work and repositories on GitHub.</p>
        <a
          href={Bio.github}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 inline-block rounded-xl bg-gradient-to-r from-brand to-brand-2 px-7 py-3 font-semibold text-white shadow-lg shadow-brand/30 transition-transform hover:scale-105"
        >
          View GitHub
        </a>
      </div>
    ) : (
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {projects.map((p) => (
          <article class="flex flex-col overflow-hidden rounded-2xl border border-brand/40 bg-card shadow-[0_4px_24px_rgba(133,76,230,0.12)] transition-transform hover:-translate-y-1">
            {p.image && <img src={p.image} alt={p.title} loading="lazy" class="h-44 w-full object-cover" />}
            <div class="flex flex-1 flex-col p-5">
              <p class="text-xs text-muted">{p.date}</p>
              <h3 class="mt-1 font-semibold text-ink">{p.title}</h3>
              <p class="mt-2 line-clamp-4 flex-1 text-sm text-ink/70">{p.description}</p>
              {p.tags?.length ? (
                <div class="mt-3 flex flex-wrap gap-2">
                  {p.tags.map((t) => <span class="rounded-md bg-brand/10 px-2 py-0.5 text-xs text-brand">{t}</span>)}
                </div>
              ) : null}
              <div class="mt-4 flex gap-3">
                {p.github && <a href={p.github} target="_blank" rel="noopener noreferrer" class="text-sm font-medium text-brand hover:underline">Code</a>}
                {p.webapp && <a href={p.webapp} target="_blank" rel="noopener noreferrer" class="text-sm font-medium text-brand hover:underline">Live</a>}
              </div>
            </div>
          </article>
        ))}
      </div>
    )}
  </div>
</section>
