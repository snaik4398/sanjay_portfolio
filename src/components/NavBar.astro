---
import Icon from './Icon.astro';

const navItems = [
  { name: 'Home', href: '#home' },
  { name: 'Skills', href: '#skills' },
  { name: 'Experience', href: '#experience' },
  { name: 'Projects', href: '#projects' },
  { name: 'Education', href: '#education' },
  { name: 'Contact', href: '#contact' },
];
---

<nav
  id="navbar"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-white dark:bg-gray-900 border-b border-gray-200 dark:border-gray-800"
>
  <div class="max-w-7xl mx-auto px-6 py-4">
    <div class="flex items-center justify-between">
      {/* Logo */}
      <a href="#home" class="text-2xl font-bold text-primary">SN</a>

      {/* Desktop Navigation */}
      <div class="hidden md:flex items-center gap-8">
        {navItems.map((item) => (
          <a
            href={item.href}
            class="text-gray-700 dark:text-gray-300 hover:text-primary dark:hover:text-primary transition-colors duration-200 font-medium"
          >
            {item.name}
          </a>
        ))}
      </div>

      <div class="flex items-center gap-2">
        {/* Theme Toggle */}
        <button
          id="theme-toggle"
          class="text-gray-700 dark:text-gray-300 hover:text-primary transition-colors p-1"
          aria-label="Toggle theme"
        >
          <span id="theme-icon-sun" class="hidden dark:inline">
            <Icon name="sun" class="w-6 h-6" />
          </span>
          <span id="theme-icon-moon" class="inline dark:hidden">
            <Icon name="moon" class="w-6 h-6" />
          </span>
        </button>

        {/* Mobile Menu Button */}
        <div class="md:hidden">
          <button
            id="mobile-menu-button"
            class="text-gray-700 dark:text-gray-300 hover:text-primary transition-colors"
            aria-label="Toggle menu"
          >
            <span id="menu-icon-open">
              <Icon name="menu" class="w-6 h-6" />
            </span>
            <span id="menu-icon-close" class="hidden">
              <Icon name="x" class="w-6 h-6" />
            </span>
          </button>
        </div>
      </div>
    </div>

    {/* Mobile Navigation */}
    <div
      id="mobile-menu"
      class="hidden md:hidden mt-4 pb-4 space-y-4 animate-slide-up border-t border-gray-200 dark:border-gray-800 pt-4"
    >
      {navItems.map((item) => (
        <a
          href={item.href}
          class="mobile-nav-link block text-gray-700 dark:text-gray-300 hover:text-primary dark:hover:text-primary transition-colors duration-200 font-medium"
        >
          {item.name}
        </a>
      ))}
    </div>
  </div>
</nav>

<script>
  // Scroll shadow/blur
  const navbar = document.getElementById('navbar');
  const scrolledClasses = [
    'bg-white/95',
    'dark:bg-gray-900/95',
    'backdrop-blur-md',
    'shadow-lg',
  ];
  const topClasses = ['bg-white', 'dark:bg-gray-900'];

  function handleScroll() {
    if (!navbar) return;
    if (window.scrollY > 50) {
      navbar.classList.remove(...topClasses);
      navbar.classList.add(...scrolledClasses);
    } else {
      navbar.classList.remove(...scrolledClasses);
      navbar.classList.add(...topClasses);
    }
  }
  window.addEventListener('scroll', handleScroll);
  handleScroll();

  // Mobile menu toggle
  const menuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIconOpen = document.getElementById('menu-icon-open');
  const menuIconClose = document.getElementById('menu-icon-close');

  function setMenuOpen(open: boolean) {
    if (!mobileMenu || !menuIconOpen || !menuIconClose) return;
    mobileMenu.classList.toggle('hidden', !open);
    menuIconOpen.classList.toggle('hidden', open);
    menuIconClose.classList.toggle('hidden', !open);
  }

  menuButton?.addEventListener('click', () => {
    const isOpen = !mobileMenu?.classList.contains('hidden');
    setMenuOpen(!isOpen);
  });

  document.querySelectorAll('.mobile-nav-link').forEach((link) => {
    link.addEventListener('click', () => setMenuOpen(false));
  });

  // Theme toggle
  const themeToggle = document.getElementById('theme-toggle');
  themeToggle?.addEventListener('click', () => {
    const root = document.documentElement;
    const isDark = root.classList.contains('dark');
    if (isDark) {
      root.classList.remove('dark');
      root.classList.add('light');
      localStorage.setItem('theme', 'light');
    } else {
      root.classList.remove('light');
      root.classList.add('dark');
      localStorage.setItem('theme', 'dark');
    }
  });
</script>
