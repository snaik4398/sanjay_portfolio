---
/*
 * One write-up per project, at /projects/<slug>/. Routes come from PROJECTS via
 * getStaticPaths, so adding a project to the config adds its page.
 *
 * Prose goes through <InlineText> because the write-ups use backticks around identifiers.
 * Links are filtered by realLinks(): entries whose href is '#' are unpublished repositories
 * and are dropped rather than rendered as dead anchors.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import InlineText from '../../components/InlineText.astro';
import {PROJECTS, STAGE_DOT, STAGE_LABELS, realLinks, type Project} from '../../data/portfolio';
import {SITE} from '../../data/portfolio';

export function getStaticPaths() {
  return PROJECTS.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const path = `/projects/${project.slug}/`;
const links = realLinks(project);

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: project.name,
  description: project.tagline,
  applicationCategory: 'DeveloperApplication',
  url: new URL(path, SITE.url).href,
  operatingSystem: 'Any',
});
---

<BaseLayout title={project.name} description={project.tagline} path={path} schema={schema}>
  <article class="mx-auto max-w-3xl gutter py-16 md:py-24">
    <nav aria-label="Breadcrumb" class="mb-10">
      <a
        href="/#projects"
        class="inline-flex items-center gap-2 text-sm text-fg-muted transition-colors duration-150 hover:text-fg"
      >
        <svg
          class="size-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M19 12H5M11 18l-6-6 6-6"></path>
        </svg>
        All Projects
      </a>
    </nav>

    <header>
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
        <p class="font-mono text-xs text-fg-muted" translate="no">{project.primary}</p>
        <p class="flex items-center gap-1.5 text-xs text-fg">
          <span
            class="size-1.5 rounded-full"
            style={`background-color: ${STAGE_DOT[project.stage]};`}
            aria-hidden="true"></span>
          {STAGE_LABELS[project.stage]}
        </p>
      </div>

      <h1 class="mt-4 text-[clamp(2rem,5vw,3rem)] font-semibold tracking-tight text-fg">
        {project.name}
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-fg-muted">{project.tagline}</p>
      <p
        class="mt-6 inline-block rounded-[var(--radius-sm)] border border-border bg-surface px-3 py-1.5 font-mono text-xs text-fg-muted"
      >
        {project.stageNote}
      </p>

      {
        links.length > 0 && (
          <ul class="mt-6 flex flex-wrap gap-2">
            {links.map((link) => (
              <li>
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex h-9 items-center rounded-[var(--radius-sm)] border border-border bg-surface px-3 text-sm text-fg transition-[background-color,border-color] duration-150 hover:border-border-strong hover:bg-surface-2"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </header>

    <section class="mt-14" aria-labelledby="overview-heading">
      <h2 id="overview-heading" class="text-xl font-semibold tracking-tight text-fg">
        Overview
      </h2>
      <div class="mt-5 space-y-5">
        {
          project.body.map((paragraph) => (
            <p class="text-base leading-relaxed text-fg-muted">
              <InlineText text={paragraph} />
            </p>
          ))
        }
      </div>
    </section>

    <section class="mt-14" aria-labelledby="stack-heading">
      <h2 id="stack-heading" class="text-xl font-semibold tracking-tight text-fg">Stack</h2>
      <dl
        class="mt-5 divide-y divide-border overflow-hidden rounded-[var(--radius-lg)] border border-border bg-surface"
      >
        {
          project.stack.map((row) => (
            <div class="flex flex-wrap gap-x-4 gap-y-1 px-5 py-3.5">
              <dt class="w-32 shrink-0 text-sm text-fg-muted">{row.layer}</dt>
              <dd class="min-w-0 flex-1 text-sm text-fg" translate="no">
                {row.choice}
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="mt-14" aria-labelledby="decisions-heading">
      <h2 id="decisions-heading" class="text-xl font-semibold tracking-tight text-fg">
        Decisions Worth Explaining
      </h2>
      <ul class="mt-5 space-y-4">
        {
          project.decisions.map((decision) => (
            <li class="rounded-[var(--radius-lg)] border border-border bg-surface p-6">
              <h3 class="text-base font-semibold tracking-tight text-fg">
                {decision.title}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-fg-muted">
                <InlineText text={decision.text} />
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    {
      project.gaps.length > 0 && (
        <section class="mt-14" aria-labelledby="gaps-heading">
          <h2 id="gaps-heading" class="text-xl font-semibold tracking-tight text-fg">
            What Is Not Done
          </h2>
          <ul class="mt-5 space-y-2.5">
            {project.gaps.map((gap) => (
              <li class="flex gap-3 text-sm leading-relaxed text-fg-muted">
                <span class="mt-2 size-1 shrink-0 rounded-full bg-accent" aria-hidden="true" />
                <span class="min-w-0">
                  <InlineText text={gap} />
                </span>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</BaseLayout>
