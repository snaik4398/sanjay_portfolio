---
/*
 * The whole portfolio, one page.
 *
 * Section order here must match NAV_LINKS in data/portfolio.ts: About, Education, Skills,
 * Experience, Projects, Contact. The Person JSON-LD is built from the same config the page
 * renders from, so the structured data cannot drift from what a visitor sees.
 */
import Certifications from '../components/Certifications.astro';
import Contact from '../components/Contact.astro';
import Education from '../components/Education.astro';
import Experience from '../components/Experience.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Section from '../components/Section.astro';
import Skills from '../components/Skills.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { BIO, EDUCATION, EXPERIENCE, PROJECTS, SITE, SOCIALS } from '../data/portfolio';

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: BIO.name,
  url: SITE.url,
  image: new URL('/profile.png', SITE.url).href,
  jobTitle: BIO.title,
  description: BIO.description,
  email: `mailto:${BIO.email}`,
  address: { '@type': 'PostalAddress', addressLocality: BIO.location },
  // Derived from SOCIALS, so commenting a profile out of that list also drops it
  // from the structured data. One place to enable or disable a profile.
  sameAs: SOCIALS.map((social) => social.href),
  worksFor: { '@type': 'Organization', name: EXPERIENCE[0]?.company },
  alumniOf: EDUCATION.map((degree) => ({
    '@type': 'CollegeOrUniversity',
    name: degree.school,
  })),
  knowsAbout: [
    'Java',
    'Spring Boot',
    'Microservices',
    'Apache Kafka',
    'PostgreSQL',
    'MongoDB',
    'Keycloak',
    'Kong API Gateway',
  ],
});
---

<BaseLayout title={SITE.title} path="/" schema={schema}>
  <Hero />

  <Section
    id="education"
    eyebrow="Education"
    title="Where I studied"
    standfirst="An M.Tech in AI and data science underway at IIT Patna, on top of a master’s in computer applications and a bachelor’s in computer science."
  >
    <Education />
    <div class="mt-6">
      <Certifications />
    </div>
  </Section>

  <Section
    id="skills"
    eyebrow="Skills"
    title="What I build with"
    standfirst="Languages, backend and distributed-systems work, data and messaging, cloud and DevOps, security and gateway policy, testing and AI tooling."
  >
    <Skills />
  </Section>

  <Section
    id="experience"
    eyebrow="Experience"
    title="Where I have worked"
    standfirst="Four years at one platform, promoted twice from SDE 1 to platform ownership. Karkinos was acquired by Jio Platform Limited during that time."
  >
    <Experience />
  </Section>

  <Section
    id="projects"
    eyebrow="Projects"
    title="Things I have built on my own time"
    standfirst="Gateway plugins, auth and file services, a transcoding platform and a few static sites, each with an honest status: what works, and what does not yet."
  >
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {PROJECTS.map((project) => <ProjectCard project={project} />)}
    </div>
  </Section>

  <Section
    id="contact"
    eyebrow="Contact"
    title="Get in touch"
    standfirst="Open to senior backend and platform work. Say hello."
  >
    <Contact />
  </Section>
</BaseLayout>
