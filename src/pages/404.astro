---
/*
 * 404 page. noindex, because a soft-404 in the index is worse than no page at all.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found" path="/404/" noindex>
  <div class="mx-auto flex min-h-[60vh] max-w-3xl flex-col items-start justify-center gutter py-20">
    <p class="font-mono text-xs uppercase tracking-[0.08em] text-accent">Error 404</p>
    <h1 class="mt-3 text-[clamp(2rem,5vw,3rem)] font-semibold tracking-tight text-fg">
      This page does not exist
    </h1>
    <p class="mt-4 max-w-md text-base leading-relaxed text-fg-muted">
      The link may be out of date, or the address mistyped. Everything on this site is
      reachable from the home page.
    </p>
    <a
      href="/"
      class="mt-8 inline-flex h-11 items-center rounded-[var(--radius)] bg-accent px-5 text-sm font-medium text-accent-fg transition-[opacity,transform] duration-150 hover:opacity-90 active:scale-[0.98]"
      style="touch-action: manipulation;"
    >
      Back to Home
    </a>
  </div>
</BaseLayout>
