---
/*
 * The page shell every route renders into: head, skip link, background canvas, header, main,
 * footer.
 *
 * BackgroundFX is fixed at z-index 0, so the content sits in a `relative z-10` wrapper above
 * it. <body> is transparent and <html> carries the page colour; see styles/global.css.
 */
import BackgroundFX from '../components/BackgroundFX.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

interface Props {
  title: string;
  description?: string;
  path?: string;
  noindex?: boolean;
  schema?: string;
}

const props = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead {...props} />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-[var(--radius-sm)] focus:border focus:border-border focus:bg-surface focus:px-4 focus:py-2 focus:text-sm focus:text-fg"
    >
      Skip to content
    </a>
    <BackgroundFX />
    <!-- Everything above the canvas. -->
    <div class="relative z-10">
      <Header />
      <main id="main">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
